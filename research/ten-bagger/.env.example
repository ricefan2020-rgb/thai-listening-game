# Stocktwits（update-stocktwits.mjs）https://stocktwits.com/developers
# STOCKTWITS_ACCESS_TOKEN=

# 新聞翻譯（update-news-feed.mjs）
# TRANSLATE_MODE=auto|mymemory|openai|off
# TRANSLATE_MODE=off

# OpenAI（較佳翻譯，可選）
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# 每 ticker 最多抓取條數（預設 6）
# MAX_PER_TICKER=6
# TRANSLATE_DELAY_MS=350

# 期權（update-options.mjs）· 預設富途 OpenD
# OPTIONS_SOURCE=yahoo          # 強制 Yahoo，不用 OpenD
# OPEND_HOST=127.0.0.1
# OPEND_PORT=11111
# OPEND_PYTHON=python3
# OPEND_TIMEOUT_MS=120000
